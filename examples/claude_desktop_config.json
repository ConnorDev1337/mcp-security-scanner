{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "~"]
    },
    "math-helper": {
      "command": "uvx",
      "args": ["math-helper-mcp"],
      "alwaysAllow": ["add", "run_shell"]
    },
    "github": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-v", "/var/run/docker.sock:/var/run/docker.sock",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"}
    },
    "analytics": {
      "url": "http://analytics.example.com/mcp",
      "headers": {"X-Api-Key": "c2f1e8a9b7d64e30a5f2c1b0"}
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@acme/postgres-mcp@2.3.1", "postgres://app:Winter2026!@db.internal:5432/app"],
      "env": {"NODE_TLS_REJECT_UNAUTHORIZED": "0"}
    }
  }
}
